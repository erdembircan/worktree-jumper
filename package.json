{
  "name": "worktree-jumper",
  "version": "1.0.0",
  "description": "Interactively jump between git worktrees from your shell",
  "keywords": [
    "git",
    "worktree",
    "git-worktree",
    "cli",
    "shell",
    "cd",
    "zsh",
    "bash",
    "fish",
    "developer-tools"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "author": "Erdem Bircan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erdembircan/worktree-jumper.git"
  },
  "homepage": "https://github.com/erdembircan/worktree-jumper#readme",
  "bugs": {
    "url": "https://github.com/erdembircan/worktree-jumper/issues"
  },
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "worktree-jumper": "bin/worktree-jumper.js"
  },
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "license:verify": "license-wizard --verify --strict"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.13.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "license-wizard": "^1.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vitest": "^3.0.4"
  }
}
